# PostgreSQL connection (Railway)
DATABASE_URL=postgresql://user:password@host:port/dbname

# GitHub REST API — personal access token, read-only stats fetch
# Backend-authenticated only; never exposed to the frontend
GITHUB_TOKEN=

# Single-user token auth for TUI-only admin write routes
ADMIN_API_TOKEN=

# Local directory uploaded demo media is saved to (needs a Railway Volume
# mounted here in production so files survive redeploys)
UPLOAD_DIR=uploads

# Public URL this backend is reachable at — used to build absolute URLs for
# uploaded files (e.g. https://your-backend.up.railway.app)
PUBLIC_BASE_URL=
