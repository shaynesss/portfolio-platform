# PostgreSQL connection (Railway)
DATABASE_URL=postgresql://user:password@host:port/dbname

# GitHub REST API — personal access token, read-only stats fetch
# Backend-authenticated only; never exposed to the frontend
GITHUB_TOKEN=

# Single-user token auth for TUI-only admin write routes
ADMIN_API_TOKEN=

# Frontend origin(s) allowed to call the public read endpoints (Vercel deploy URL)
CORS_ORIGINS=
